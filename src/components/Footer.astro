---
import { LINKS } from '../lib/constants'
---

<footer class="mx-auto max-w-2xl px-4">
  <div class="my-8 flex flex-col items-center gap-4">
    <p class="text-foreground/40 text-sm text-balance text-center">
      Built by
      <a
        href={LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        class="group text-foreground/70 hover:text-primary transition-colors duration-200"
      >
        <span class="relative inline-block">
          Bhavesh Singh
        </span>
      </a>.
      &copy; {new Date().getFullYear()}.
    </p>
  </div>
</footer>
