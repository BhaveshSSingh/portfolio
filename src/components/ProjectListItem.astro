---
import { Image } from 'astro:assets'

interface Project {
  title: string
  url: string
  description: string
  tech: string
  thumbnail?: ImageMetadata
}

interface Props {
  project: Project
}

const { project } = Astro.props
const isExternal = project.url.startsWith('http')
---

<a
  href={project.url}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class="group flex gap-4 sm:gap-5"
>
  {project.thumbnail && (
    <Image
      src={project.thumbnail}
      alt={project.title}
      width={320}
      densities={[1, 2]}
      loading="lazy"
      class="h-20 w-32 shrink-0 rounded-md object-cover object-top ring-1 ring-inset ring-white/10 transition-all duration-200 group-hover:ring-white/20 sm:h-24 sm:w-40"
    />
  )}

  <div class="min-w-0 flex-1">
    <div class="flex items-baseline justify-between gap-4">
      <h3 class="truncate text-base font-medium text-neutral-50 transition-colors duration-200 group-hover:text-white">
        {project.title}
      </h3>
      <span class="hidden shrink-0 font-mono text-xs font-light text-neutral-500 sm:block">
        {project.tech}
      </span>
    </div>

    <p class="mt-1.5 line-clamp-2 text-pretty text-sm leading-6 text-neutral-400">
      {project.description}
    </p>
  </div>
</a>
