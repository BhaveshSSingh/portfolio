---
import BaseLayout from '../../layouts/BaseLayout.astro'

const permissions = [
  {
    name: 'storage',
    reason:
      'Stores your Do-Less and Do-More lists, settings, snooze status, daily goal, and local usage stats on your device.',
  },
  {
    name: 'tabs',
    reason:
      'Reads the active tab URL so Nudgy can classify the current site and count active time correctly.',
  },
  {
    name: 'idle',
    reason:
      'Pauses local time tracking when your device is idle or locked, so idle minutes do not inflate your stats.',
  },
  {
    name: 'alarms',
    reason:
      'Runs a lightweight local timer to update usage totals and end timed snoozes.',
  },
  {
    name: 'scripting',
    reason:
      "Shows Nudgy's self-contained in-page nudge on sites you have listed and registers custom sites you add.",
  },
  {
    name: 'optional host access',
    reason:
      'Requested only when you add a custom site, and scoped to that site so Nudgy can appear there.',
  },
]
---

<BaseLayout
  title="Nudgy Privacy Policy"
  description="Privacy policy for Nudgy, a local-only browser extension."
>
  <div class="mx-auto max-w-2xl px-4 pb-14 pt-4 md:pt-8">
    <div class="flex items-center justify-between">
      <a
        href="/nudgy"
        class="group relative font-mono text-xs font-light text-neutral-500 transition-colors duration-200 hover:text-neutral-200"
      >
        <span class="relative inline-block">
          back to Nudgy
          <span
            class="pointer-events-none absolute bottom-0 left-0 h-px w-full bg-neutral-700 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          ></span>
        </span>
      </a>
      <span class="font-mono text-xs text-neutral-600"
        >Updated June 28, 2026</span
      >
    </div>

    <header class="mt-12">
      <p class="font-mono text-xs uppercase tracking-wide text-violet-300">
        Privacy policy
      </p>
      <h1
        class="mt-2 text-3xl font-semibold tracking-tight text-neutral-50 md:text-4xl"
      >
        Nudgy
      </h1>
      <p class="mt-5 text-pretty text-lg leading-8 text-neutral-200">
        Nudgy is designed to be local-only. It has no accounts, no backend, no
        analytics, no ads, no tracking services, and no network calls.
      </p>
    </header>

    <section class="mt-10 space-y-5 text-base leading-7 text-neutral-400">
      <div>
        <h2 class="text-lg font-medium text-neutral-50">Data storage</h2>
        <p class="mt-2">
          Nudgy stores your site lists, settings, snooze state, focus session
          state, daily goal, and usage stats in Chrome extension storage on your
          device. This data is used only to run the extension features you
          choose to use.
        </p>
      </div>

      <div>
        <h2 class="text-lg font-medium text-neutral-50">Data transfer</h2>
        <p class="mt-2">
          Nudgy does not transmit your data to any server. Your lists, settings,
          and stats are not uploaded, sold, shared, rented, or used for
          advertising.
        </p>
      </div>

      <div>
        <h2 class="text-lg font-medium text-neutral-50">
          Data Nudgy does not collect
        </h2>
        <p class="mt-2">
          Nudgy does not collect personally identifiable information, health
          information, financial information, authentication information,
          personal communications, location, or browsing history sent
          off-device.
        </p>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="font-mono text-sm uppercase tracking-wide text-neutral-500">
        Permissions
      </h2>
      <div class="mt-5 flex flex-col gap-4">
        {
          permissions.map((permission) => (
            <article class="rounded-md border border-white/10 bg-white/[0.03] p-4">
              <h3 class="font-mono text-sm text-neutral-100">
                {permission.name}
              </h3>
              <p class="mt-2 text-pretty text-sm leading-6 text-neutral-400">
                {permission.reason}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-12 space-y-5 text-base leading-7 text-neutral-400">
      <div>
        <h2 class="text-lg font-medium text-neutral-50">Deleting data</h2>
        <p class="mt-2">
          You can remove Nudgy's local data by uninstalling the extension from
          your browser. You can also clear extension storage through your
          browser's extension management tools.
        </p>
      </div>

      <div>
        <h2 class="text-lg font-medium text-neutral-50">Contact</h2>
        <p class="mt-2">
          For privacy questions, email
          <a
            href="mailto:bhaveshsinghbiz@gmail.com"
            class="text-neutral-100 underline decoration-neutral-600 underline-offset-4 transition-colors hover:decoration-neutral-300"
          >
            bhaveshsinghbiz@gmail.com
          </a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
