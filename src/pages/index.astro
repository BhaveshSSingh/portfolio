---
import BaseLayout from '../layouts/BaseLayout.astro'
import { LINKS } from '../lib/constants'
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
---

<BaseLayout title={t('home.title')} description={t('home.description')}>
  <main class="mx-auto max-w-2xl px-6 py-24 text-gray-300">
    <section class="space-y-12">
      <div class="flex justify-between items-baseline">
        <h1 class="text-4xl font-bold tracking-tight text-white">Bhavesh Singh</h1>
        <p class="text-gray-500 font-mono">/home</p>
      </div>

      <div class="space-y-6 text-lg leading-relaxed">
        <p>
          I am Bhavesh, I enjoy making tech products but also provide value outside of tech. 
          You can read about my journey from intern to lead <a href="https://www.linkedin.com/posts/levelsupermind_story-of-bhavesh-singh-from-intern-to-team-activity-7320419727367979008-PGK-" target="_blank" class="text-white underline hover:text-gray-400 decoration-gray-600 underline-offset-4">here</a>.
        </p>
        <p>
          Currently, I am diving deep into the world of AI and building awesome AI products at 
          <a href="https://schbanglabs.com/" target="_blank" class="text-white underline hover:text-gray-400 decoration-gray-600 underline-offset-4">Schbang</a>.
        </p>
        <p>
          I am also leading the engineering for <a href="https://secondbrain.schbanglabs.com/" target="_blank" class="text-white underline hover:text-gray-400 decoration-gray-600 underline-offset-4">Second Brain for Brands</a> 
          at Schbang.
        </p>
        <p>
          Beyond tech, I am passionate about lifting weights and watching anime.
        </p>
      </div>

      <div class="h-px bg-white/10 w-full my-12"></div>

      <ul class="space-y-4 font-mono text-sm">
        <li class="flex items-center gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-gray-600"></span>
          <span class="text-gray-500 w-20">LinkedIn</span>
          <a href={LINKS.linkedin} target="_blank" class="text-white hover:underline">@bhavesh-singh</a>
        </li>
        <li class="flex items-center gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-gray-600"></span>
          <span class="text-gray-500 w-20">GitHub</span>
          <a href={LINKS.github} target="_blank" class="text-white hover:underline">@BhaveshSSingh</a>
        </li>
        <li class="flex items-center gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-gray-600"></span>
          <span class="text-gray-500 w-20">Twitter</span>
          <a href={LINKS.twitter} target="_blank" class="text-white hover:underline">@Bhaveshh_Singh</a>
        </li>
        <li class="flex items-center gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-gray-600"></span>
          <span class="text-gray-500 w-20">Resume</span>
          <a href="/bhaveshsingh.pdf" target="_blank" class="text-white hover:underline">bhaveshsingh.pdf</a>
        </li>
        <li class="flex items-center gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-gray-600"></span>
          <span class="text-gray-500 w-20">Email</span>
          <a href={LINKS.mail} class="text-white hover:underline">bhaveshsinghbiz@gmail.com</a>
        </li>
        <li class="flex items-center gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-gray-600"></span>
          <span class="text-gray-500 w-20">Work</span>
          <a href="/work" class="text-white hover:underline">Work Experience</a>
        </li>
        <li class="flex items-center gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-gray-600"></span>
          <span class="text-gray-500 w-20">Projects</span>
          <a href="/projects" class="text-white hover:underline">Personal Projects</a>
        </li>
      </ul>

      <div class="pt-24 text-gray-600 text-xs font-mono">
          {new Date().getFullYear()} © Bhavesh Singh.
      </div>
    </section>
  </main>
</BaseLayout>
