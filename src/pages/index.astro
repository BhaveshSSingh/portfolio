---
import BaseLayout from '../layouts/BaseLayout.astro'
import PostListItem from '../components/PostListItem.astro'
import TabNav from '../components/TabNav.astro'
import { LINKS } from '../lib/constants'
import { POSTS } from '../lib/posts'
import {
  getLangFromUrl,
  useTranslations,
} from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const brandIcons = {
  auditbot: 'https://auditbot.co/wp-content/uploads/2025/03/favicon-150x150.png',
  schbang: 'https://cdn.prod.website-files.com/64081b3f2fda69c80b5566e5/649a7faa42bc962c81b8c90f_Schbang%20Logomark%20(Custom)%20(1).png',
  secondBrain: 'https://secondbrain.schbanglabs.com/favicon.ico',
}

const thingsIDo = [
  {
    title: 'Runtime Labs',
    description: 'Working on cool AI projects — hit me up',
    url: 'https://runtimelabs.space/',
    external: true,
    gradient: 'from-amber-400 to-amber-600',
    offset: 'ring-offset-amber-500',
    icon: 'rocket',
    wave: true,
  },
  {
    title: 'YeetCode',
    description: 'Building the best free place to learn DSA.',
    url: 'https://yeetcode.in/',
    external: true,
    gradient: 'from-pink-400 to-pink-600',
    offset: 'ring-offset-pink-500',
    icon: 'book',
  },
]

const connect = [
  {
    title: 'Email',
    description: 'bhaveshsinghbiz@gmail.com',
    url: LINKS.mail,
    external: false,
    gradient: 'from-red-400 to-red-600',
    offset: 'ring-offset-red-500',
    icon: 'mail',
  },
  {
    title: 'LinkedIn',
    description: '@bhavesh-singh',
    url: LINKS.linkedin,
    external: true,
    gradient: 'from-sky-400 to-sky-600',
    offset: 'ring-offset-sky-500',
    icon: 'linkedin',
  },
  {
    title: 'Resume',
    description: 'View my latest resume',
    url: '/bhaveshsingh.pdf',
    external: true,
    gradient: 'from-orange-400 to-orange-600',
    offset: 'ring-offset-orange-500',
    icon: 'document',
  },
]

const homePosts = POSTS.slice(0, 3)
---

<BaseLayout title={t('home.title')} description={t('home.description')}>
  <div class="mx-auto max-w-2xl px-4 pt-4 md:pt-8 pb-10">
    <section>
      <div class="flex items-center gap-2">
        <img
          src="/bhavesh.jpeg"
          alt="Bhavesh Singh"
          class="aspect-square size-6 rounded-md object-cover shadow-2xl"
        />
        <h1 class="text-xl font-medium tracking-tight text-foreground md:text-2xl">
          Bhavesh Singh
        </h1>
      </div>

      <div class="pt-5">
        <TabNav />
      </div>

      <p class="pt-5 text-base text-foreground/90">
        I'm Bhavesh — I enjoy making tech products and providing value outside of tech. Currently diving deep into AI and building products at <a href="https://auditbot.co/" target="_blank" rel="noopener noreferrer" class="inline-flex items-baseline gap-1.5 text-foreground underline decoration-foreground/30 underline-offset-4 transition-colors hover:decoration-foreground/60"><img src={brandIcons.auditbot} alt="" class="relative top-0.5 size-4 shrink-0 rounded-sm" loading="lazy" />AuditBot</a>. Previously, I was Tech Lead at <a href="https://www.schbang.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-baseline gap-1.5 text-foreground underline decoration-foreground/30 underline-offset-4 transition-colors hover:decoration-foreground/60"><img src={brandIcons.schbang} alt="" class="relative top-0.5 size-4 shrink-0 rounded-sm" loading="lazy" />Schbang</a>, where I led engineering for <a href="https://secondbrain.schbanglabs.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-baseline gap-1.5 text-foreground underline decoration-foreground/30 underline-offset-4 transition-colors hover:decoration-foreground/60"><img src={brandIcons.secondBrain} alt="" class="relative top-0.5 size-4 shrink-0 rounded-sm" loading="lazy" />SecondBrain</a>. Beyond tech, I lift weights and watch anime.
      </p>

      <p class="pt-4 text-base text-foreground/90">
        Say hi on <a href={LINKS.twitter} target="_blank" rel="noopener noreferrer" class="inline-flex items-baseline gap-1.5 text-foreground underline decoration-foreground/30 underline-offset-4 transition-colors hover:decoration-foreground/60"><img src="https://svgl.app/library/x_dark.svg" alt="" class="relative top-0.5 size-4 shrink-0" loading="lazy" />Twitter</a> and <a href={LINKS.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-baseline gap-1.5 text-foreground underline decoration-foreground/30 underline-offset-4 transition-colors hover:decoration-foreground/60"><img src="https://svgl.app/library/github_dark.svg" alt="" class="relative top-0.5 size-4 shrink-0" loading="lazy" />GitHub</a>.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="font-mono text-sm uppercase tracking-wide text-foreground/40">Things I do</h2>
      <div class="mt-4 flex flex-col gap-6 md:gap-4">
        {thingsIDo.map((item) => (
          <a
            href={item.url}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class="group flex flex-col items-start gap-1 md:flex-row md:items-center md:gap-2"
          >
            <div class={`relative flex aspect-square size-8 items-center justify-center rounded-sm align-middle bg-gradient-to-b ${item.gradient} shadow-lg ring-1 ring-inset ring-white/20 ring-offset-2 ${item.offset} mr-2`}>
              {item.icon === 'rocket' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.63 8.41m5.96 5.96a14.926 14.926 0 01-5.84 2.58m-.12-8.54a6 6 0 00-7.38 5.84h4.8m2.58-5.84a14.927 14.927 0 00-2.58 5.84m9.0-2.46a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />
                </svg>
              )}
              {item.icon === 'book' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.04A8.97 8.97 0 006 3.75c-1.05 0-2.06.18-3 .51v14.25A8.99 8.99 0 016 18c2.31 0 4.41.87 6 2.29m0-14.25a8.97 8.97 0 016-2.29c1.05 0 2.06.18 3 .51v14.25A8.99 8.99 0 0018 18a8.97 8.97 0 00-6 2.29m0-14.25v14.25" />
                </svg>
              )}
            </div>
            <p class="font-medium text-foreground shrink-0">{item.title}</p>
            <div class="hidden size-1 rounded-full bg-foreground/20 md:block"></div>
            <p class="text-foreground/70 text-pretty">
              {item.description}{item.wave && <span class="wave-emoji ml-1 inline-block">👋</span>}
            </p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-12">
      <h2 class="font-mono text-sm uppercase tracking-wide text-foreground/40">Connect</h2>
      <div class="mt-4 flex flex-col gap-6">
        {connect.map((item) => (
          <a
            href={item.url}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class="group flex flex-col items-start gap-1 md:flex-row md:items-center md:gap-2"
          >
            <div class={`relative flex aspect-square size-8 items-center justify-center rounded-sm align-middle bg-gradient-to-b ${item.gradient} shadow-lg ring-1 ring-inset ring-white/20 ring-offset-2 ${item.offset} mr-2`}>
              {item.icon === 'mail' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
              {item.icon === 'linkedin' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              )}
              {item.icon === 'document' && (
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              )}
            </div>
            <p class="font-medium text-foreground shrink-0">{item.title}</p>
            <div class="hidden size-1 rounded-full bg-foreground/20 md:block"></div>
            <p class="text-foreground/70 text-pretty">{item.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-12 flex flex-col gap-4">
      <h2 class="font-mono text-sm uppercase tracking-wide text-foreground/40">Writing</h2>
      <div class="flex flex-col gap-4">
        {homePosts.map((post) => (
          <PostListItem post={post} />
        ))}
      </div>
    </section>

    <div class="my-8 text-sm text-foreground/40 text-balance">
      {new Date().getFullYear()} © Bhavesh Singh.
    </div>
  </div>
</BaseLayout>

<style>
  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
  }
  .wave-emoji {
    transform-origin: 70% 70%;
    animation: wave 2.5s ease-in-out infinite;
  }
</style>
