---
import BaseLayout from '../../layouts/BaseLayout.astro'

const features = [
  {
    title: 'Truly private',
    description:
      'Every frame is analyzed on-device with Apple’s Vision framework, then thrown away. Nothing is recorded, uploaded, or stored — ever.',
  },
  {
    title: 'A gentle nudge',
    description:
      'Drop below your line and a soft “Look up a bit!” appears. Straighten up and it quietly disappears — that’s the whole interaction.',
  },
  {
    title: 'Camera off until needed',
    description:
      'In Periodic mode the camera stays off and wakes for just a few seconds every few minutes, so that green light isn’t staring at you all day.',
  },
  {
    title: 'Featherweight & native',
    description:
      'A native Swift + Vision app that lives in your menu bar and sips a sliver of CPU. No Electron, no bloat, no Dock clutter.',
  },
]

const steps = [
  {
    n: '1',
    title: 'Calibrate once',
    description:
      'Sit the way you actually want to sit and click Calibrate. Upright locks that eye level in as your personal target. Re-calibrate anytime in a tap.',
  },
  {
    n: '2',
    title: 'It watches your eye level',
    description:
      'Upright tracks where your eyes sit against the line you calibrated. You can tune how much of a slump it tolerates, from relaxed to laser-strict.',
  },
  {
    n: '3',
    title: 'It nudges, then gets out of the way',
    description:
      'Slouch and the menu-bar icon glows amber with a soft prompt. Sit back up and it goes calm again. No dashboards, no streaks, no guilt.',
  },
]
---

<BaseLayout
  title="Upright - sit up straight, without thinking about it"
  description="Upright is a tiny, private Mac menu-bar app that watches your eye level on-device and gently nudges you when you slouch."
>
  <div class="mx-auto max-w-2xl px-4 pb-14 pt-4 md:pt-8">
    <div class="flex items-center justify-between">
      <a
        href="/projects"
        class="group relative font-mono text-xs font-light text-neutral-500 transition-colors duration-200 hover:text-neutral-200"
      >
        <span class="relative inline-block">
          back to projects
          <span
            class="pointer-events-none absolute bottom-0 left-0 h-px w-full bg-neutral-700 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          ></span>
        </span>
      </a>
      <span class="font-mono text-xs text-neutral-600">macOS 13 Ventura+</span>
    </div>

    <section class="mt-12">
      <div class="flex items-center gap-4">
        <img
          src="/upright/icon.png"
          alt="Upright"
          class="size-14 shrink-0 drop-shadow-lg"
        />
        <div>
          <p class="font-mono text-xs uppercase tracking-wide text-violet-300">
            Mac menu-bar app
          </p>
          <h1
            class="text-3xl font-semibold tracking-tight text-neutral-50 md:text-4xl"
          >
            Upright
          </h1>
        </div>
      </div>

      <p class="mt-6 text-pretty text-lg leading-8 text-neutral-200">
        Upright quietly watches your eye level through your webcam and gives you
        a gentle nudge the moment you start to slouch — then gets out of your
        way. Private, on-device, and it leaves your camera off until it’s
        needed.
      </p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href="/upright/Upright.pkg"
          download
          class="inline-flex h-10 items-center justify-center gap-2 rounded-md bg-neutral-50 px-4 text-sm font-medium text-neutral-950 transition-colors hover:bg-neutral-200"
        >
          <svg viewBox="0 0 24 24" fill="none" class="size-4" aria-hidden="true"
            ><path
              d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
          Download for Mac
        </a>
        <a
          href="https://github.com/BhaveshSSingh/upright"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-10 items-center justify-center gap-2 rounded-md border border-white/10 px-4 text-sm font-medium text-neutral-200 transition-colors hover:bg-white/5"
        >
          <svg viewBox="0 0 16 16" fill="currentColor" class="size-4" aria-hidden="true"
            ><path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          >
          View on GitHub
        </a>
      </div>
      <p class="mt-3 font-mono text-xs text-neutral-500">
        Free · macOS 13 Ventura+ · Apple Silicon &amp; Intel · <a
          href="/upright/Upright.zip"
          download
          class="underline decoration-neutral-600 underline-offset-4 transition-colors hover:text-neutral-300 hover:decoration-neutral-300"
          >grab the .zip instead</a
        >
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-mono text-sm uppercase tracking-wide text-neutral-500">
        What it does
      </h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {
          features.map((feature) => (
            <article class="rounded-md border border-white/10 bg-white/[0.03] p-4">
              <h3 class="text-sm font-medium text-neutral-50">
                {feature.title}
              </h3>
              <p class="mt-2 text-pretty text-sm leading-6 text-neutral-400">
                {feature.description}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="how" class="mt-14">
      <h2 class="font-mono text-sm uppercase tracking-wide text-neutral-500">
        How it works
      </h2>
      <div class="mt-5 flex flex-col gap-4">
        {
          steps.map((step) => (
            <article class="flex gap-4 rounded-md border border-white/10 bg-white/[0.03] p-4">
              <span class="flex size-7 shrink-0 items-center justify-center rounded-md border border-amber-400/30 bg-amber-400/10 font-mono text-xs font-semibold text-amber-300">
                {step.n}
              </span>
              <div>
                <h3 class="text-sm font-medium text-neutral-50">{step.title}</h3>
                <p class="mt-2 text-pretty text-sm leading-6 text-neutral-400">
                  {step.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-14">
      <h2 class="font-mono text-sm uppercase tracking-wide text-neutral-500">
        Is it safe?
      </h2>
      <div class="mt-5 rounded-md border border-white/10 bg-white/[0.03] p-5">
        <p class="text-pretty text-sm leading-6 text-neutral-300">
          Short answer: yes. Upright isn’t notarized because I haven’t paid
          Apple’s $99/year developer tax — so the first time you open it, macOS
          may throw a scary “unidentified developer” warning. That only means
          macOS doesn’t recognize the signature, <strong
            class="font-medium text-neutral-100">not that anything is wrong</strong
          >.
        </p>
        <p class="mt-3 text-pretty text-sm leading-6 text-neutral-400">
          Everything runs on-device with zero network calls, nothing is recorded
          or uploaded, and the entire source is public. Don’t take my word for
          it — read every line before you trust it.
        </p>
        <p class="mt-3 text-pretty text-sm leading-6 text-neutral-400">
          To open it: right-click <strong class="font-medium text-neutral-200"
            >Upright</strong
          > → <strong class="font-medium text-neutral-200">Open</strong>, or
          allow it under <span class="text-neutral-200"
            >System Settings → Privacy &amp; Security</span
          >. After that it launches normally.
        </p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <a
            href="https://github.com/BhaveshSSingh/upright"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-10 items-center justify-center gap-2 rounded-md bg-neutral-50 px-4 text-sm font-medium text-neutral-950 transition-colors hover:bg-neutral-200"
          >
            <svg viewBox="0 0 16 16" fill="currentColor" class="size-4" aria-hidden="true"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
            View the source on GitHub
          </a>
          <a
            href="/upright/Upright.pkg"
            download
            class="inline-flex h-10 items-center justify-center gap-2 rounded-md border border-white/10 px-4 text-sm font-medium text-neutral-200 transition-colors hover:bg-white/5"
          >
            Download installer (.pkg)
          </a>
        </div>
      </div>
    </section>

    <section class="mt-14 border-t border-white/10 pt-8">
      <h2 class="text-xl font-medium tracking-tight text-neutral-50">
        Stays on your Mac
      </h2>
      <p class="mt-4 text-pretty text-base leading-7 text-neutral-400">
        Upright has no accounts, no backend, no analytics, and no network calls.
        Your calibration and settings live on your own device, and your camera
        feed never leaves it. Free, with no subscription — the only thing it
        tracks is your eye level.
      </p>
    </section>
  </div>
</BaseLayout>
