---
import BaseLayout from '../../layouts/BaseLayout.astro'
import TabNav from '../../components/TabNav.astro'
import ProjectListItem from '../../components/ProjectListItem.astro'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'
import devledgerCover from '../../assets/projects/devledger.png'
import uprightCover from '../../assets/upright/cover.png'
import nudgyCover from '../../assets/nudgy/popup-status.png'
import imagekingCover from '../../assets/projects/imageking.png'
import signalrankCover from '../../assets/projects/signalrank.png'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const activeProjects = [
  {
    title: 'YeetCode',
    url: 'https://yeetcode.in/',
    description:
      'My personal coding journal where I gamify learning in a fun way. Features a private authentication system and a clean interface for tracking my development journey.',
    tech: 'Next.js, Authentication, Gamification',
    thumbnail: devledgerCover,
  },
  {
    title: 'Upright',
    url: '/projects/upright',
    description:
      'A tiny Mac menu-bar app that watches your eye level on-device and gives you a gentle nudge the moment you slouch — then gets out of your way. Private, native, camera off until needed.',
    tech: 'macOS, Swift, Vision, On-device',
    thumbnail: uprightCover,
  },
  {
    title: 'Nudgy',
    url: '/nudgy/',
    description:
      'A cute, local-only focus buddy for Chrome and Edge that gently nudges you toward good sites and softly away from distractions.',
    tech: 'Browser Extension, MV3, Local-first',
    thumbnail: nudgyCover,
  },
]

const archivedProjects = [
  {
    title: 'ImageKing',
    url: 'https://imageking.vercel.app/',
    description:
      'Convert images to WebP format locally - completely free and unlimited. No server uploads, all processing happens in your browser for maximum privacy and speed.',
    tech: 'Next.js, Client-side Processing',
    thumbnail: imagekingCover,
  },
  {
    title: 'SignalRank',
    url: 'https://signalrank.vercel.app/',
    description:
      "Track and analyze your brand's visibility across AI platforms. Monitor how AI models respond to prompts related to your brand and competitors in real-time.",
    tech: 'Next.js, AI Analytics, Brand Monitoring',
    thumbnail: signalrankCover,
  },
]
---

<BaseLayout
  title={`Projects - ${t('home.title')}`}
  description="Personal projects by Bhavesh Singh"
>
  <div class="mx-auto max-w-2xl px-4 pb-10 pt-4 md:pt-8">
    <div class="flex items-center justify-between">
      <h1
        class="text-xl font-medium tracking-tight text-neutral-50 md:text-2xl"
      >
        Projects
      </h1>
      <a
        href="/"
        class="group relative font-mono text-xs font-light text-neutral-500 transition-colors duration-200 hover:text-neutral-200"
      >
        <span class="relative inline-block">
          back
          <span
            class="pointer-events-none absolute bottom-0 left-0 h-px w-full bg-neutral-700 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          ></span>
        </span>
      </a>
    </div>

    <div class="mt-5">
      <TabNav />
    </div>

    <p class="mt-5 text-pretty text-base text-neutral-400">
      A small collection of side projects I've shipped. Each one started as an
      itch I wanted to scratch.
    </p>

    <section class="mt-8">
      <div class="flex flex-col gap-6">
        {
          activeProjects.map((project) => (
            <ProjectListItem project={project} />
          ))
        }
      </div>
    </section>

    <section class="mt-14 border-t border-white/10 pt-10">
      <h2 class="font-mono text-sm uppercase tracking-wide text-neutral-500">
        Archived / not actively maintained
      </h2>

      <div class="mt-6 flex flex-col gap-6">
        {
          archivedProjects.map((project) => (
            <ProjectListItem project={project} />
          ))
        }
      </div>
    </section>

    <p class="mt-12 text-balance font-mono text-xs font-light text-neutral-600">
      {new Date().getFullYear()} &copy; Bhavesh Singh.
    </p>
  </div>
</BaseLayout>
