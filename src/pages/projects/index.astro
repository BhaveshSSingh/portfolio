---
import BaseLayout from '../../layouts/BaseLayout.astro'
import TabNav from '../../components/TabNav.astro'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const projects = [
  {
    title: 'YeetCode',
    url: 'https://yeetcode.in/',
    description: 'My personal coding journal where I gamify learning in a fun way. Features a private authentication system and a clean interface for tracking my development journey.',
    tech: 'Next.js, Authentication, Gamification',
    thumbnail: '/devledger.png',
  },
  {
    title: 'ImageKing',
    url: 'https://imageking.vercel.app/',
    description: 'Convert images to WebP format locally - completely free and unlimited. No server uploads, all processing happens in your browser for maximum privacy and speed.',
    tech: 'Next.js, Client-side Processing',
    thumbnail: '/imageking.png',
  },
  {
    title: 'SignalRank',
    url: 'https://signalrank.vercel.app/',
    description: 'Track and analyze your brand\'s visibility across AI platforms. Monitor how AI models respond to prompts related to your brand and competitors in real-time.',
    tech: 'Next.js, AI Analytics, Brand Monitoring',
    thumbnail: '/signalrank.png',
  }
]
---

<BaseLayout title={`Projects - ${t('home.title')}`} description="Personal projects by Bhavesh Singh">
  <div class="mx-auto max-w-2xl px-4 pt-4 md:pt-8 pb-10">
    <div class="flex items-center justify-between">
      <h1 class="text-xl font-medium tracking-tight text-neutral-50 md:text-2xl">Projects</h1>
      <a href="/" class="group relative font-mono text-xs font-light text-neutral-500 transition-colors duration-200 hover:text-neutral-200">
        <span class="relative inline-block">
          back
          <span class="pointer-events-none absolute bottom-0 left-0 h-px w-full bg-neutral-700 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></span>
        </span>
      </a>
    </div>

    <div class="mt-5">
      <TabNav />
    </div>

    <p class="mt-5 text-base text-neutral-400 text-pretty">
      A small collection of side projects I've shipped. Each one started as an itch I wanted to scratch.
    </p>

    <section class="mt-10">
      <h2 class="font-mono text-sm uppercase tracking-wide text-neutral-500">Selected work</h2>

      <div class="mt-6 flex flex-col gap-10">
        {projects.map((project) => (
          <article class="group flex flex-col gap-4">
            {project.thumbnail && (
              <a href={project.url} target="_blank" rel="noopener noreferrer" class="block">
                <img
                  src={project.thumbnail}
                  alt={project.title}
                  class="w-full rounded-md shadow-lg ring-1 ring-white/10 ring-inset transition-all duration-200 group-hover:ring-white/20"
                />
              </a>
            )}

            <div class="flex flex-col gap-1">
              <div class="flex items-baseline justify-between gap-6">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/title relative"
                >
                  <span class="relative inline-block">
                    <span class="text-base font-medium text-neutral-50 transition-colors duration-200 group-hover/title:text-white">
                      {project.title}
                    </span>
                    <span class="pointer-events-none absolute bottom-0 left-0 h-px w-full bg-neutral-600 opacity-0 transition-opacity duration-300 group-hover/title:opacity-100"></span>
                  </span>
                </a>
                <span class="shrink-0 font-mono text-xs font-light text-neutral-500">{project.tech}</span>
              </div>
              <p class="text-sm text-neutral-400 text-pretty">
                {project.description}
              </p>
            </div>

            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group/visit relative inline-flex w-fit items-center font-mono text-xs font-light text-neutral-400 transition-colors duration-200 hover:text-neutral-100"
            >
              <span class="relative inline-block">
                Visit project
                <span class="pointer-events-none absolute bottom-0 left-0 h-px w-full bg-neutral-600 opacity-0 transition-opacity duration-300 group-hover/visit:opacity-100"></span>
              </span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <p class="mt-12 font-mono text-xs font-light text-neutral-600 text-balance">
      {new Date().getFullYear()} &copy; Bhavesh Singh.
    </p>
  </div>
</BaseLayout>
