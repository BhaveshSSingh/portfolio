---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostListItem from '../../components/PostListItem.astro'
import TabNav from '../../components/TabNav.astro'
import { POSTS } from '../../lib/posts'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<BaseLayout title={`Blogs - ${t('home.title')}`} description="Writing by Bhavesh Singh">
  <div class="mx-auto max-w-2xl px-4 pt-4 md:pt-8 pb-10">
    <section>
      <h1 class="text-xl font-medium tracking-tight text-white md:text-2xl">Blogs</h1>

      <div class="mt-5">
        <TabNav />
      </div>

      <ul class="mt-8 flex flex-col gap-8">
        {/* List starts at offsetTop 140 with ~110px rows, so every thumbnail sits
            above the fold on any realistic window. Revisit past ~7 posts. */}
        {POSTS.map((post) => (
          <li>
            <PostListItem post={post} eager />
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
